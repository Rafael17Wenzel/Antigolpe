# Variáveis de ambiente do backend (Spring Boot).
# O Spring NÃO lê este arquivo: defina as variáveis no sistema ou no painel do Render.
# Nenhum valor secreto real deve ser colocado aqui.

# Porta HTTP (o Render define automaticamente). Padrão: 8080
PORT=8080

# Origens liberadas no CORS, separadas por vírgula.
# Padrão: http://localhost:5173,https://antigolpe-1.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Perfil: dev (PostgreSQL local + dados fictícios) | h2 (sem banco instalado) | vazio (produção)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (JDBC)
DB_URL=jdbc:postgresql://localhost:5432/antigolpe
DB_USER=antigolpe
DB_PASSWORD=

# Chave de assinatura do JWT da área do RH (mínimo de 32 caracteres). Opcional: sem ela,
# a API gera uma chave aleatória a cada início e as sessões caem ao reiniciar.
# Gere uma com: openssl rand -base64 48
JWT_SECRET=

# Limite de tentativas de login do RH por minuto e por cliente. Padrão: 5
LIMITE_LOGIN_POR_MINUTO=5

# Limite de requisições por cliente (429 ao exceder). Padrões: 20 / 10 / 30
LIMITE_VALIDACAO_POR_MINUTO=20
LIMITE_DENUNCIA_POR_HORA=10
LIMITE_SUGESTAO_POR_MINUTO=30

# Endereço real do cliente atrás de proxy: none (local) | native (Render)
FORWARD_HEADERS_STRATEGY=none

# Retenção em dias (validações / denúncias). Padrões: 90 / 180
RETENCAO_VALIDACAO_DIAS=90
RETENCAO_DENUNCIA_DIAS=180

# Dados FICTÍCIOS de demonstração (vagas e tokens rotulados). Padrão: false
DEMO_SEED=false

# Alternativa a DB_URL/DB_USER/DB_PASSWORD no formato do Render (postgresql://usuario:senha@host:porta/banco).
# Usada só se DB_URL não estiver definida.
# DATABASE_URL=

# Google Gemini: leitura do token em prints no simulador de chat (só no backend; NUNCA em VITE_*).
# Crie a chave no Google AI Studio e defina aqui/no painel. Sem ela, o site usa a leitura local.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Envios de imagem ao Gemini por minuto e por cliente. Padrão: 5
LIMITE_GEMINI_POR_MINUTO=5
